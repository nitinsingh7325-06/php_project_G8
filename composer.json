{
    "name": "thewave/mens-salon",
    "description": "The Wave Men's Salon - Production-ready salon management system",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-gd": "*",
        "ext-curl": "*",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^2.0",
        "phpoffice/phpspreadsheet": "^2.0",
        "twilio/sdk": "^7.16",
        "stripe/stripe-php": "^13.0",
        "razorpay/razorpay": "^2.9",
        "google/cloud-storage": "^1.41",
        "google/apiclient": "^2.15",
        "predis/predis": "^2.2",
        "firebase/php-jwt": "^6.10",
        "endroid/qr-code": "^5.0",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "serve": "php -S localhost:8080 -t public",
        "migrate": "php scripts/migrate.php",
        "seed": "php scripts/seed.php"
    }
}