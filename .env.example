# Application
APP_NAME="The Wave Men's Salon"
APP_ENV=local
APP_DEBUG=true
APP_URL=https://localhost
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_OPENSSL

# Security
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict
SESSION_LIFETIME=60
CSRF_TOKEN_LIFETIME=30

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wave_salon
DB_USERNAME=wave
DB_PASSWORD=secure_password_here
DB_SOCKET=
DB_SSL_CA=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=wave:
USE_REDIS=false
CACHE_TTL=3600

# OTP / SMS
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_WINDOW_MINUTES=10
OTP_LENGTH=6
SMS_PROVIDER=log
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_FROM=+1234567890
VONAGE_KEY=your_vonage_key
VONAGE_SECRET=your_vonage_secret
VONAGE_FROM=TheWave

# Email
OTP_FALLBACK_EMAIL=true
MAIL_FROM=noreply@thewavemenssalon.com
MAIL_FROM_NAME="The Wave Men's Salon"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls

# Payments
PAYMENT_GATEWAY=stripe
STRIPE_PUBLIC_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_WEBHOOK_URL=https://your-domain.com/webhook/stripe
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# Google Cloud
GCP_PROJECT_ID=your-project-id
GCP_STORAGE_BUCKET=wave-salon-media
GCP_CREDENTIALS_PATH=/path/to/credentials.json
GOOGLE_MAPS_API_KEY=AIzaSy_xxxx
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_ID=sheet_id_here
USE_CLOUD_STORAGE=false

# Firebase
FCM_SERVER_KEY=AAAA_xxxx
FCM_ENABLED=false

# Loyalty
LOYALTY_POINTS_PER_RUPEE=1
LOYALTY_GOLD_THRESHOLD=500
LOYALTY_PLATINUM_THRESHOLD=2000
LOYALTY_DIAMOND_THRESHOLD=5000

# Salon
SALON_NAME="The Wave Men's Salon"
SALON_PHONE=+919876543210
SALON_EMAIL=hello@thewavemenssalon.com
SALON_ADDRESS="123 Luxury Avenue, Premium District, Mumbai"
SALON_LAT=28.6139
SALON_LNG=77.2090
SALON_OPEN=09:00
SALON_CLOSE=21:00
SALON_TIMEZONE=Asia/Kolkata
SALON_CURRENCY=INR
SALON_TAX_RATE=18

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Queue
QUEUE_DRIVER=redis
QUEUE_CONNECTION=redis

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# Backup
BACKUP_ENABLED=true
BACKUP_DRIVER=gcp
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily
BACKUP_RETENTION_DAYS=30

# Monitoring
ERROR_TRACKING_ENABLED=true
PERFORMANCE_MONITORING=true

# Feature Flags
FEATURE_WAITLIST=true
FEATURE_MULTI_LOCATION=false
FEATURE_ONLINE_PAYMENTS=true
FEATURE_GDPR_COMPLIANCE=true

# GDPR
GDPR_COOKIE_CONSENT=true
GDPR_DATA_RETENTION_DAYS=365
GDPR_AUTO_DELETE_INACTIVE=false